# Application
NODE_ENV=development
PORT=3000
APP_NAME=Filmporte Backend
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=filmporte
DB_SYNCHRONIZE=true          # set to false in production
DB_LOGGING=true

# JWT
JWT_SECRET=super-secret-change-this-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=another-super-secret-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12